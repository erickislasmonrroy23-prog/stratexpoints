# ========================================
# Backend Environment Configuration
# ========================================

# Server Configuration
NODE_ENV=development
PORT=3001
BACKEND_URL=http://localhost:3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stratexpoints
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_MASTER_KEY=your-256-bit-master-key-in-hex-format

# Frontend Configuration
# In production add your Vercel domain: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/backend.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
ENABLE_HTTPS=false
HSTS_MAX_AGE=31536000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External Services
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# Feature Flags
ENABLE_MULTI_KEY=true
ENABLE_BATCH_OPERATIONS=true
ENABLE_KMS_INTEGRATION=false
